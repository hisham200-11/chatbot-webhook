# ============================================================
# Chatbot Webhook — Environment Variables
# Copy this file to .env and fill in your real values.
# ============================================================

# -- AI Provider (choose one) --
# Options: groq (FREE & FAST, recommended), gemini (FREE), or openai (paid)
AI_PROVIDER=groq

# -- Groq Cloud (FREE - 14,400 requests/day, no credit card required) --
# Get your free key in 30 seconds at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key

# -- Google Gemini (FREE - 1,500 requests/day) --
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# -- OpenAI (requires billing - set AI_PROVIDER=openai to use) --
OPENAI_API_KEY=sk-your-openai-api-key

# -- Facebook Messenger --
PAGE_ACCESS_TOKEN=your_page_access_token
VERIFY_TOKEN=your_verify_token
FB_APP_ID=your_facebook_app_id

# -- Clinic Configuration --
CLINIC_NAME=BrightSmile Dental Clinic
CLINIC_LOCATION=BGC, Taguig City
CLINIC_HOURS=Mon-Sat 9AM-6PM
CLINIC_SERVICES=Veneers, Dental Implants, Braces/Invisalign, Teeth Whitening, General Dentistry

# -- MySQL Database --
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=chatbot_db_railway_fbmessenger

# -- Email Notifications (SMTP) --
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ADMIN_EMAIL=clinic_owner@email.com