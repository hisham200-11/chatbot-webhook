# ============================================================
# Chatbot Webhook — Environment Variables
# Copy this file to .env and fill in your real values.
# ============================================================

# -- Facebook Messenger --
PAGE_ACCESS_TOKEN=your_page_access_token
VERIFY_TOKEN=your_verify_token
FB_APP_ID=your_facebook_app_id

# -- OpenAI (GPT-4o-mini for AI qualification) --
OPENAI_API_KEY=sk-your-openai-api-key

# -- Clinic Configuration --
CLINIC_NAME=BrightSmile Dental Clinic
CLINIC_LOCATION=BGC, Taguig City
CLINIC_HOURS=Mon-Sat 9AM-6PM
CLINIC_SERVICES=Veneers, Dental Implants, Braces/Invisalign, Teeth Whitening, General Dentistry

# -- MySQL Database --
DB_HOST=your_db_host
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# -- Email Notifications (SMTP) --
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ADMIN_EMAIL=clinic_owner@email.com
